# AWS Production Environment Variables

# Database - RDS MySQL
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_HOST=ticketrush-mysql.ctimwy80mzsu.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=ticketrush_db

# Redis - ElastiCache
REDIS_HOST=ticketrush-redis-001-001.ticketrush-redis-001.3gu1ru.apse1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=true

# AWS Configuration
AWS_REGION=ap-southeast-1

# S3
S3_BUCKET_NAME=ticketrush-assets-hieu
USE_S3=true

# SQS
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/016370843094/ticketrush-ticket-generation
USE_SQS=true

# SES
SES_FROM_EMAIL=noreply@yourdomain.com
USE_SES=true

# CORS - ALB DNS or CloudFront domain
CORS_ORIGINS=http://ticketrush-alb-1438253633.ap-southeast-1.elb.amazonaws.com,http://localhost:5500,http://127.0.0.1:5500

# App
APP_ENV=production
DEBUG=false
