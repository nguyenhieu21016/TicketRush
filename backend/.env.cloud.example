# AWS Production Environment Variables

# Database - RDS MySQL
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_HOST=ticketrush-db.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=ticketrush_db

# Redis - ElastiCache
REDIS_HOST=ticketrush-redis.xxxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=true

# AWS Configuration
AWS_REGION=us-east-1

# S3
S3_BUCKET_NAME=ticketrush-qr-codes-RANDOM
USE_S3=true

# SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/ticketrush-ticket-generation
USE_SQS=true

# SES
SES_FROM_EMAIL=noreply@yourdomain.com
USE_SES=true

# CORS - ALB DNS or CloudFront domain
CORS_ORIGINS=http://ticketrush-alb-xxxxx.us-east-1.elb.amazonaws.com,https://yourdomain.com

# App
APP_ENV=production
DEBUG=false
