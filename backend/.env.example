DB_USER=root
DB_PASSWORD=local_root_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketrush_db

# Redis - for seat reservation, cache-aside, and rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
# Optional single Redis URL (overrides split REDIS_* vars when set; leave empty to use REDIS_HOST)
# Example: redis://localhost:6379/0 or rediss://<elasticache-endpoint>:6379/0
REDIS_URL=

# Rate limiting for booking endpoints (per user/IP, fixed window)
RATE_LIMIT_BOOKING=10
RATE_LIMIT_BOOKING_WINDOW=60

# AWS Configuration
AWS_REGION=ap-southeast-1

# S3 - for QR codes and event images
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
USE_S3=false

# SQS - for async ticket generation / ticket email pipeline
# Leave SQS_QUEUE_URL empty (or USE_SQS=false) to use direct SMTP fallback (local dev)
SQS_QUEUE_URL=
USE_SQS=false
# DynamoDB table for Lambda idempotency (Lambda env var, not FastAPI)
IDEMPOTENCY_TABLE=ticketrush-ticket-idempotency

# SES - for email via AWS SES
SES_FROM_EMAIL=
USE_SES=false

# SMTP fallback settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# App
APP_ENV=local
DEBUG=true
