DB_USER=root
DB_PASSWORD=local_root_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketrush_db

# SMTP settings used to email QR ticket attachments
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Redis (ElastiCache) — Cache-Aside + Rate Limiting
# Local dev: redis://localhost:6379/0
# AWS:       redis://<elasticache-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limiting for POST /api/bookings (per user/IP, sliding window)
RATE_LIMIT_BOOKING=10
RATE_LIMIT_BOOKING_WINDOW=60
